rules_version = '3';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    //  GLOBAL HELPERS  —  Reusable functions for all collections
    // ═══════════════════════════════════════════════════════════════

    /** Returns true if the request is from an authenticated user. */
    function isAuthenticated() {
      return request.auth != null;
    }

    /** Returns true if the authenticated user's UID matches the given userId. */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /** Returns true if the authenticated user is the author of the resource. */
    function isAuthor() {
      return isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    /** Returns true if the authenticated user is the author of the incoming write. */
    function isAuthorOfIncoming() {
      return isAuthenticated() && request.resource.data.authorId == request.auth.uid;
    }

    /** Returns true if the user has an admin or moderator custom claim. */
    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.admin == true || request.auth.token.moderator == true);
    }

    /** Validates that a string field exists, is a string, and is within length bounds. */
    function isValidString(field, minLen, maxLen) {
      return request.resource.data.keys().hasAny([field])
        && request.resource.data[field] is string
        && request.resource.data[field].size() >= minLen
        && request.resource.data[field].size() <= maxLen;
    }

    /** Validates that a field is a list with bounded length. */
    function isValidList(field, maxLen) {
      return request.resource.data.keys().hasAny([field])
        && request.resource.data[field] is list
        && request.resource.data[field].size() <= maxLen;
    }

    /** Validates that a field is an integer within a range. */
    function isValidInt(field, min, max) {
      return request.resource.data.keys().hasAny([field])
        && request.resource.data[field] is int
        && request.resource.data[field] >= min
        && request.resource.data[field] <= max;
    }

    /** Validates that a field is a number (int or float) within a range. */
    function isValidNumber(field, min, max) {
      return request.resource.data.keys().hasAny([field])
        && request.resource.data[field] is number
        && request.resource.data[field] >= min
        && request.resource.data[field] <= max;
    }

    /** Validates that a field is a valid Firestore Timestamp. */
    function isValidTimestamp(field) {
      return request.resource.data.keys().hasAny([field])
        && request.resource.data[field] is timestamp;
    }

    /** Validates that a field is a boolean. */
    function isValidBool(field) {
      return request.resource.data.keys().hasAny([field])
        && request.resource.data[field] is bool;
    }

    /** Validates that a field is a valid URL string (basic protocol check). */
    function isValidUrl(field) {
      return request.resource.data.keys().hasAny([field])
        && request.resource.data[field] is string
        && (
          request.resource.data[field].matches('^https://.+')
          || request.resource.data[field] == ''
        );
    }

    /** Rate-limit helper: prevents rapid re-writes by the same user on the same doc.
        Enforces a minimum 5-second gap between updates. */
    function respectsCooldown() {
      return request.time > resource.data.updatedAt + duration.value(5, "seconds");
    }

    /** Prevent mass-deletion or mass-update attacks by limiting batch writes. */
    function notBatchWrite() {
      return !request.writeFields.hasAll(['__batchWrite']);
    }

    // ═══════════════════════════════════════════════════════════════
    //  USERS  —  /users/{userId}
    // ═══════════════════════════════════════════════════════════════

    match /v1/taletranscend/projects/v1/users/{userId} {
      // Anyone can read public profile data
      allow read: if true;

      // Only the owner can create or update their own profile
      allow create: if isOwner(userId)
        && isValidString('name', 1, 100)
        && isValidString('bio', 0, 2000)
        && isValidString('pronouns', 0, 50)
        && isValidUrl('avatarUrl')
        && isValidUrl('website')
        && isValidString('twitterHandle', 0, 50)
        && isValidString('instagramHandle', 0, 50)
        && isValidInt('readingGoal', 0, 1000000)
        && isValidList('favouriteGenres', 20)
        && isValidNumber('totalWordsWritten', 0, 1000000000)
        && isValidNumber('totalReaders', 0, 1000000000)
        && isValidInt('writingStreak', 0, 3650)
        && request.resource.data.keys().hasAll(['joinedAt'])
        && isValidTimestamp('joinedAt')
        && isValidTimestamp('updatedAt')
        && request.resource.data.createdAt == request.time; // Enforce server-set createdAt on create

      allow update: if isOwner(userId)
        && respectsCooldown()
        && isValidString('name', 1, 100)
        && isValidString('bio', 0, 2000)
        && isValidString('pronouns', 0, 50)
        && isValidUrl('avatarUrl')
        && isValidUrl('website')
        && isValidString('twitterHandle', 0, 50)
        && isValidString('instagramHandle', 0, 50)
        && isValidInt('readingGoal', 0, 1000000)
        && isValidList('favouriteGenres', 20)
        && isValidNumber('totalWordsWritten', 0, 1000000000)
        && isValidNumber('totalReaders', 0, 1000000000)
        && isValidInt('writingStreak', 0, 3650)
        && isValidTimestamp('updatedAt');

      // Only owner or admin can delete
      allow delete: if isOwner(userId) || isAdmin();

      // ═══════════════════════════════════════════════════════════
      //  USER SUBCOLLECTIONS  —  Drafts, Progress, Bookmarks
      // ═══════════════════════════════════════════════════════════

      // DRAFTS  —  /users/{userId}/drafts/{draftId}
      match /drafts/{draftId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && isValidString('title', 0, 200)
          && isValidString('synopsis', 0, 5000)
          && isValidString('description', 0, 2000)
          && isValidString('coverUrl', 0, 500)
          && isValidString('era', 0, 100)
          && isValidString('tone', 0, 100)
          && isValidString('language', 0, 50)
          && isValidString('audience', 0, 100)
          && isValidString('worldSetting', 0, 2000)
          && isValidString('authorNotes', 0, 5000)
          && isValidInt('chapterCount', 0, 1000)
          && isValidInt('wordCount', 0, 10000000)
          && isValidInt('estimatedReadMins', 0, 1000000)
          && isValidString('status', 0, 50)
          && isValidList('tags', 50)
          && isValidList('contentWarnings', 50)
          && isValidList('searchKeywords', 200)
          && isValidTimestamp('createdAt')
          && isValidTimestamp('updatedAt')
          && request.resource.data.authorId == userId;

        allow update: if isOwner(userId)
          && respectsCooldown()
          && isValidString('title', 0, 200)
          && isValidString('synopsis', 0, 5000)
          && isValidString('description', 0, 2000)
          && isValidString('coverUrl', 0, 500)
          && isValidString('era', 0, 100)
          && isValidString('tone', 0, 100)
          && isValidString('language', 0, 50)
          && isValidString('audience', 0, 100)
          && isValidString('worldSetting', 0, 2000)
          && isValidString('authorNotes', 0, 5000)
          && isValidInt('chapterCount', 0, 1000)
          && isValidInt('wordCount', 0, 10000000)
          && isValidInt('estimatedReadMins', 0, 1000000)
          && isValidString('status', 0, 50)
          && isValidList('tags', 50)
          && isValidList('contentWarnings', 50)
          && isValidList('searchKeywords', 200)
          && isValidTimestamp('updatedAt');

        allow delete: if isOwner(userId) || isAdmin();
      }

      // PROGRESS  —  /users/{userId}/progress/{taleId}
      match /progress/{taleId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && isValidString('taleId', 1, 100)
          && request.resource.data.taleId == taleId
          && isValidNumber('scrollPercent', 0, 100)
          && isValidInt('lastChapterIndex', 0, 1000)
          && isValidTimestamp('updatedAt')
          && request.resource.data.keys().hasAll(['chapters'])
          && request.resource.data.chapters is map;

        allow update: if isOwner(userId)
          && isValidNumber('scrollPercent', 0, 100)
          && isValidInt('lastChapterIndex', 0, 1000)
          && isValidTimestamp('updatedAt')
          && request.resource.data.keys().hasAll(['chapters'])
          && request.resource.data.chapters is map;

        allow delete: if isOwner(userId) || isAdmin();
      }

      // BOOKMARKS  —  /users/{userId}/bookmarks/{bookmarkId}
      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && isValidString('taleId', 1, 100)
          && isValidString('userId', 1, 100)
          && request.resource.data.userId == userId
          && isValidTimestamp('createdAt')
          && isValidTimestamp('updatedAt');

        allow update: if isOwner(userId)
          && isValidTimestamp('updatedAt');

        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════════════
    //  TALES  —  /tales/{taleId}
    //  Public read. Write restricted to author, admin, or moderation.
    // ═══════════════════════════════════════════════════════════════

    match /v1/taletranscend/projects/v1/tales/{taleId} {
      // Public read for published tales; drafts hidden
      allow read: if resource.data.visibility == 'public'
        || resource.data.status == 'published'
        || isAuthor()
        || isAdmin();

      // Create: must be authenticated, set self as author, valid fields
      allow create: if isAuthenticated()
        && isAuthorOfIncoming()
        && isValidString('title', 1, 200)
        && isValidString('synopsis', 0, 5000)
        && isValidString('description', 0, 2000)
        && isValidString('coverUrl', 0, 500)
        && isValidString('era', 0, 100)
        && isValidString('tone', 0, 100)
        && isValidString('language', 0, 50)
        && isValidString('audience', 0, 100)
        && isValidString('worldSetting', 0, 2000)
        && isValidString('authorNotes', 0, 5000)
        && isValidInt('chapterCount', 0, 1000)
        && isValidInt('wordCount', 0, 10000000)
        && isValidInt('estimatedReadMins', 0, 1000000)
        && isValidString('status', 0, 50)
        && isValidString('visibility', 0, 50)
        && isValidList('tags', 50)
        && isValidList('contentWarnings', 50)
        && isValidList('searchKeywords', 200)
        && isValidBool('isFeatured')
        && isValidBool('isEditorsPick')
        && isValidNumber('readCount', 0, 1000000000)
        && isValidNumber('commentCount', 0, 1000000000)
        && isValidNumber('reactionCount', 0, 1000000000)
        && isValidNumber('bookmarkCount', 0, 1000000000)
        && isValidTimestamp('submittedAt')
        && isValidTimestamp('publishedAt')
        && isValidTimestamp('createdAt')
        && isValidTimestamp('updatedAt');

      // Update: author can update their own tale; admin can moderate
      allow update: if (isAuthor() || isAdmin())
        && respectsCooldown()
        && isValidString('title', 1, 200)
        && isValidString('synopsis', 0, 5000)
        && isValidString('description', 0, 2000)
        && isValidString('coverUrl', 0, 500)
        && isValidString('era', 0, 100)
        && isValidString('tone', 0, 100)
        && isValidString('language', 0, 50)
        && isValidString('audience', 0, 100)
        && isValidString('worldSetting', 0, 2000)
        && isValidString('authorNotes', 0, 5000)
        && isValidInt('chapterCount', 0, 1000)
        && isValidInt('wordCount', 0, 10000000)
        && isValidInt('estimatedReadMins', 0, 1000000)
        && isValidString('status', 0, 50)
        && isValidString('visibility', 0, 50)
        && isValidList('tags', 50)
        && isValidList('contentWarnings', 50)
        && isValidList('searchKeywords', 200)
        && isValidBool('isFeatured')
        && isValidBool('isEditorsPick')
        && isValidNumber('readCount', 0, 1000000000)
        && isValidNumber('commentCount', 0, 1000000000)
        && isValidNumber('reactionCount', 0, 1000000000)
        && isValidNumber('bookmarkCount', 0, 1000000000)
        && isValidTimestamp('updatedAt');

      // Delete: author or admin only
      allow delete: if isAuthor() || isAdmin();

      // ═══════════════════════════════════════════════════════════
      //  CHAPTERS  —  /tales/{taleId}/chapters/{chapterIndex}
      // ═══════════════════════════════════════════════════════════

      match /chapters/{chapterIndex} {
        allow read: if get(/databases/$(database)/documents/tales/$(taleId)).data.visibility == 'public'
          || get(/databases/$(database)/documents/tales/$(taleId)).data.status == 'published'
          || isAdmin()
          || (
            isAuthenticated()
            && get(/databases/$(database)/documents/tales/$(taleId)).data.authorId == request.auth.uid
          );

        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/tales/$(taleId)).data.authorId == request.auth.uid
          && isValidString('title', 0, 200)
          && isValidString('content', 0, 500000)  // ~500KB max per chapter
          && isValidInt('index', 0, 1000)
          && isValidInt('wordCount', 0, 100000)
          && isValidInt('estimatedReadMins', 0, 10000)
          && isValidTimestamp('createdAt')
          && isValidTimestamp('updatedAt');

        allow update: if isAuthenticated()
          && get(/databases/$(database)/documents/tales/$(taleId)).data.authorId == request.auth.uid
          && respectsCooldown()
          && isValidString('title', 0, 200)
          && isValidString('content', 0, 500000)
          && isValidInt('index', 0, 1000)
          && isValidInt('wordCount', 0, 100000)
          && isValidInt('estimatedReadMins', 0, 10000)
          && isValidTimestamp('updatedAt');

        allow delete: if isAuthenticated()
          && get(/databases/$(database)/documents/tales/$(taleId)).data.authorId == request.auth.uid
          || isAdmin();
      }

      // ═══════════════════════════════════════════════════════════
      //  COMMENTS  —  /tales/{taleId}/comments/{commentId}
      // ═══════════════════════════════════════════════════════════

      match /comments/{commentId} {
        // Public read for published tales
        allow read: if get(/databases/$(database)/documents/tales/$(taleId)).data.visibility == 'public'
          || get(/databases/$(database)/documents/tales/$(taleId)).data.status == 'published'
          || isAdmin();

        // Create: authenticated users only, with strict content validation
        allow create: if isAuthenticated()
          && isValidString('text', 1, 5000)
          && isValidString('taleId', 1, 100)
          && request.resource.data.taleId == taleId
          && isValidString('authorId', 1, 100)
          && request.resource.data.authorId == request.auth.uid
          && isValidString('authorName', 1, 100)
          && isValidString('type', 1, 50)
          && request.resource.data.type in ['general', 'chapter']
          && isValidInt('depth', 0, 3)  // Prevent deep nesting abuse
          && isValidInt('replyCount', 0, 10000)
          && isValidInt('likeCount', 0, 1000000)
          && isValidInt('reportCount', 0, 1000)
          && isValidBool('isEdited')
          && isValidBool('isPinned')
          && isValidBool('isHidden')
          && isValidString('parentId', 0, 100)
          && isValidString('chapterIndex', 0, 10)  // Can be null or string
          && isValidTimestamp('createdAt')
          && isValidTimestamp('updatedAt')
          // Prevent empty or whitespace-only comments
          && request.resource.data.text.trim().size() > 0;

        // Update: only the author can edit their own comment; admins can hide/pin
        allow update: if (
            isAuthenticated()
            && resource.data.authorId == request.auth.uid
            && isValidString('text', 1, 5000)
            && request.resource.data.text.trim().size() > 0
            && isValidBool('isEdited')
            && request.resource.data.isEdited == true
            && isValidTimestamp('updatedAt')
            && isValidTimestamp('editedAt')
          ) || (
            isAdmin()
            && isValidBool('isHidden')
            && isValidBool('isPinned')
            && isValidInt('reportCount', 0, 1000)
          );

        // Delete: author or admin
        allow delete: if (
          isAuthenticated() && resource.data.authorId == request.auth.uid
        ) || isAdmin();
      }

      // ═══════════════════════════════════════════════════════════
      //  REACTIONS  —  /tales/{taleId}/reactions/{reactionId}
      // ═══════════════════════════════════════════════════════════

      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if isAuthenticated()
          && isValidString('userId', 1, 100)
          && request.resource.data.userId == request.auth.uid
          && isValidString('taleId', 1, 100)
          && request.resource.data.taleId == taleId
          && isValidString('type', 1, 50)
          && request.resource.data.type in ['like', 'love', 'insightful', 'mythic']
          && isValidTimestamp('createdAt');

        allow update: if isAuthenticated()
          && resource.data.userId == request.auth.uid
          && isValidString('type', 1, 50)
          && request.resource.data.type in ['like', 'love', 'insightful', 'mythic']
          && isValidTimestamp('updatedAt');

        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // ═══════════════════════════════════════════════════════════════
    //  ADMIN / MODERATION COLLECTIONS
    // ═══════════════════════════════════════════════════════════════

    // REPORTS  —  /reports/{reportId}
    match /v1/taletranscend/projects/v1/reports/{reportId} {
      allow create: if isAuthenticated()
        && isValidString('reporterId', 1, 100)
        && request.resource.data.reporterId == request.auth.uid
        && isValidString('targetId', 1, 100)
        && isValidString('targetType', 1, 50)
        && request.resource.data.targetType in ['tale', 'comment', 'user']
        && isValidString('reason', 1, 500)
        && isValidString('status', 1, 50)
        && request.resource.data.status == 'pending'
        && isValidTimestamp('createdAt');

      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // MODERATION LOG  —  /moderationLogs/{logId}
    match /v1/taletranscend/projects/v1/moderationLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isValidString('moderatorId', 1, 100)
        && request.resource.data.moderatorId == request.auth.uid
        && isValidString('action', 1, 100)
        && isValidString('targetId', 1, 100)
        && isValidString('targetType', 1, 50)
        && isValidString('reason', 1, 1000)
        && isValidTimestamp('createdAt');
      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  SYSTEM / CONFIG COLLECTIONS
    // ═══════════════════════════════════════════════════════════════

    // APP CONFIG  —  /appConfig/{docId}
    match /v1/taletranscend/projects/v1/appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FEATURE FLAGS  —  /featureFlags/{flagId}
    match /v1/taletranscend/projects/v1/featureFlags/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  GLOBAL FALLBACK  —  Deny everything not explicitly matched
    // ═══════════════════════════════════════════════════════════════

    match /v1/taletranscend/projects/v1/{document=**} {
      allow read, write: if false;
    }
  }
}
