{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/tales/:id/read/:path*", "destination": "/reader" },
    { "source": "/tales/:id/read", "destination": "/reader" },
    { "source": "/tales/:id/chapter/:path*", "destination": "/reader" },
    { "source": "/tales/:id/chapter", "destination": "/reader" },
    { "source": "/tales/:id/chapters/:path*", "destination": "/reader" },
    { "source": "/tales/:id/chapters", "destination": "/reader" },
    { "source": "/tales/:id/fragment/:path*", "destination": "/reader" },
    { "source": "/tales/:id/fragment", "destination": "/reader" },
    { "source": "/tales/:id/fragments/:path*", "destination": "/reader" },
    { "source": "/tales/:id/fragments", "destination": "/reader" },
    { "source": "/chapter/:path*", "destination": "/reader" },
    { "source": "/chapters/:path*", "destination": "/reader" },
    { "source": "/fragment/:path*", "destination": "/reader" },
    { "source": "/fragments/:path*", "destination": "/reader" },
    { "source": "/reader/:path*", "destination": "/reader" },
    { "source": "/tales/:path*", "destination": "/tale" },
    { "source": "/toc/:path*", "destination": "/toc" },
    { "source": "/sitemap", "destination": "/toc" },
    { "source": "/library/:path*", "destination": "/library" },
    { "source": "/shelf/:path*", "destination": "/shelf" },
    { "source": "/tale/:path*", "destination": "/tale" },
    { "source": "/contribution/:path*", "destination": "/contribution" },
    { "source": "/profile/:path*", "destination": "/profile" },
    { "source": "/login/:path*", "destination": "/login" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
