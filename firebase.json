{
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/library", "destination": "/library.html" },
      { "source": "/library/**", "destination": "/library.html" },
      { "source": "/shelf", "destination": "/shelf.html" },
      { "source": "/shelf/**", "destination": "/shelf.html" },
      { "source": "/reader", "destination": "/reader.html" },
      { "source": "/reader/**", "destination": "/reader.html" },
      { "source": "/tale", "destination": "/tale.html" },
      { "source": "/tale/**", "destination": "/tale.html" },
      { "source": "/contribution", "destination": "/contribution.html" },
      { "source": "/contribution/**", "destination": "/contribution.html" },
      { "source": "/profile", "destination": "/profile.html" },
      { "source": "/profile/**", "destination": "/profile.html" },
      { "source": "/login", "destination": "/login.html" },
      { "source": "/login/**", "destination": "/login.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  }
}
