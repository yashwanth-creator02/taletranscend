{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@fb/*": ["src/firebase/*"],
      "@services/*": ["src/services/*"],
      "@state/*": ["src/state/*"],
      "@shared/*": ["src/shared/*"],
      "@features/*": ["src/features/*"],
      "@config/*": ["src/config/*"],
      "@css/*": ["src/assets/css/*"],
      "@/*": ["src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
