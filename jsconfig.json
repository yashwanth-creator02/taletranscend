{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@services/*": ["js/core/services/*"],
      "@core/*": ["js/core/*"],
      "@ui/*": ["js/ui/*"],
      "@pages/*": ["js/pages/*"],
      "@config/*": ["config/*"],
      "@css/*": ["css/*"],
      "@/*": ["js/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
