{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@fb/*": ["src/firebase/*"],
      "@services/*": ["src/services/*"],
      "@ui/*": ["src/ui/*"],
      "@pages/*": ["src/pages/*"],
      "@config/*": ["src/config/*"],
      "@css/*": ["src/assets/css/*"],
      "@core/*": ["js/core/*"],
      "@/*": ["src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
