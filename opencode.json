{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "firebase": {
        "type": "local",
        "command": ["npx", "-y", "firebase-tools@latest", "experimental:mcp"]
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      }
    }
  }
}
